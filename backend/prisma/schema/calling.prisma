model VirtualNumber {
  id String @id @default(uuid()) @db.Uuid

  number String @unique @map("number") @db.VarChar(30)

  displayName String? @map("display_name") @db.VarChar(100)

  provider         String  @map("provider") @db.VarChar(100)
  providerNumberId String? @map("provider_number_id") @db.VarChar(200)

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  status VirtualNumberStatus @default(ACTIVE) @map("status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  calls Call[]

  @@index([groupId])
  @@index([provider])
  @@index([status])
  @@map("virtual_numbers")
}

model CallOutcome {
  id String @id @default(uuid()) @db.Uuid

  name String @map("name") @db.VarChar(100)
  code String @unique @map("code") @db.VarChar(100)

  category CallOutcomeCategory @map("category")

  requiresFollowup Boolean @default(false) @map("requires_followup")
  requiresNote     Boolean @default(false) @map("requires_note")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  calls Call[]

  @@map("call_outcomes")
}

model Call {
  id String @id @default(uuid()) @db.Uuid

  // Exactly one of leadId / applicationId is set (enforced in the service layer): sales calls hit a
  // Lead, recruiter calls hit a job Application.
  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id])

  // Null for an inbound IVR call no CRM user answered (unanswered, or answered on a non-CRM phone).
  agentId String? @map("agent_id") @db.Uuid
  agent   User?   @relation("CallAgent", fields: [agentId], references: [id])

  virtualNumberId String?        @map("virtual_number_id") @db.Uuid
  virtualNumber   VirtualNumber? @relation(fields: [virtualNumberId], references: [id])

  provider       String  @map("provider") @db.VarChar(100)
  providerCallId String? @map("provider_call_id") @db.VarChar(255)

  direction CallDirection @map("direction")
  status    CallStatus    @map("status")

  agentNumber    String? @map("agent_number") @db.VarChar(30)
  customerNumber String? @map("customer_number") @db.VarChar(30)

  // Raw provider call-group/campaign classification (CallerDesk's `call_group`, e.g. "callgroup1"),
  // verbatim - never translated to a business label ("Sales"/"Partnership") here. That mapping is a
  // display-only concern (frontend/lib/call-group.ts) so an unmapped or unknown value is still
  // stored and shown as-is, never silently dropped or guessed into an existing category. Null for
  // calls the provider never classified (e.g. outbound, or a Live event with no report yet).
  callGroup String? @map("call_group") @db.VarChar(100)

  startedAt  DateTime? @map("started_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")

  durationSeconds Int? @map("duration_seconds")

  outcomeId String?      @map("outcome_id") @db.Uuid
  outcome   CallOutcome? @relation(fields: [outcomeId], references: [id])

  notes String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recording       CallRecording?
  transcript      CallTranscript?
  recoveryActions RecoveryAction[]

  @@index([leadId])
  @@index([applicationId])
  @@index([agentId])
  @@index([virtualNumberId])
  @@index([providerCallId])
  @@index([status])
  @@index([startedAt])
  @@index([callGroup])
  @@map("calls")
}

model CallRecording {
  id String @id @default(uuid()) @db.Uuid

  callId String @unique @map("call_id") @db.Uuid
  call   Call   @relation(fields: [callId], references: [id])

  providerRecordingId String? @map("provider_recording_id") @db.VarChar(255)

  recordingUrl    String? @map("recording_url")
  storageProvider String? @map("storage_provider") @db.VarChar(100)

  durationSeconds Int?    @map("duration_seconds")
  fileSizeBytes   BigInt? @map("file_size_bytes")

  status String? @map("status") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@map("call_recordings")
}

model CallTranscript {
  id String @id @default(uuid()) @db.Uuid

  callId String @unique @map("call_id") @db.Uuid
  call   Call   @relation(fields: [callId], references: [id])

  transcriptText String? @map("transcript_text")
  // Same words as transcriptText, reformatted into speaker-labeled lines ("Agent: ...\nCustomer: ...")
  // from Deepgram's diarization. Null when diarization found only one speaker (nothing to label).
  diarizedText   String? @map("diarized_text")
  summary        String? @map("summary")

  language String? @map("language") @db.VarChar(20)
  provider String? @map("provider") @db.VarChar(100)

  status String? @map("status") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("call_transcripts")
}
