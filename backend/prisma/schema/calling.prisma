model VirtualNumber {
  id String @id @default(uuid()) @db.Uuid

  number String @unique @map("number") @db.VarChar(30)

  displayName String? @map("display_name") @db.VarChar(100)

  provider         String  @map("provider") @db.VarChar(100)
  providerNumberId String? @map("provider_number_id") @db.VarChar(200)

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  status VirtualNumberStatus @default(ACTIVE) @map("status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  calls Call[]

  @@index([groupId])
  @@index([provider])
  @@index([status])
  @@map("virtual_numbers")
}

model CallOutcome {
  id String @id @default(uuid()) @db.Uuid

  name String @map("name") @db.VarChar(100)
  code String @unique @map("code") @db.VarChar(100)

  category CallOutcomeCategory @map("category")

  requiresFollowup Boolean @default(false) @map("requires_followup")
  requiresNote     Boolean @default(false) @map("requires_note")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  calls Call[]

  @@map("call_outcomes")
}

model Call {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  agentId String @map("agent_id") @db.Uuid
  agent   User   @relation("CallAgent", fields: [agentId], references: [id])

  virtualNumberId String?        @map("virtual_number_id") @db.Uuid
  virtualNumber   VirtualNumber? @relation(fields: [virtualNumberId], references: [id])

  provider       String  @map("provider") @db.VarChar(100)
  providerCallId String? @map("provider_call_id") @db.VarChar(255)

  direction CallDirection @map("direction")
  status    CallStatus    @map("status")

  agentNumber    String? @map("agent_number") @db.VarChar(30)
  customerNumber String? @map("customer_number") @db.VarChar(30)

  startedAt  DateTime? @map("started_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")

  durationSeconds Int? @map("duration_seconds")

  outcomeId String?      @map("outcome_id") @db.Uuid
  outcome   CallOutcome? @relation(fields: [outcomeId], references: [id])

  notes String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recording       CallRecording?
  transcript      CallTranscript?
  recoveryActions RecoveryAction[]

  @@index([leadId])
  @@index([agentId])
  @@index([virtualNumberId])
  @@index([providerCallId])
  @@index([status])
  @@index([startedAt])
  @@map("calls")
}

model CallRecording {
  id String @id @default(uuid()) @db.Uuid

  callId String @unique @map("call_id") @db.Uuid
  call   Call   @relation(fields: [callId], references: [id])

  providerRecordingId String? @map("provider_recording_id") @db.VarChar(255)

  recordingUrl    String? @map("recording_url")
  storageProvider String? @map("storage_provider") @db.VarChar(100)

  durationSeconds Int?    @map("duration_seconds")
  fileSizeBytes   BigInt? @map("file_size_bytes")

  status String? @map("status") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@map("call_recordings")
}

model CallTranscript {
  id String @id @default(uuid()) @db.Uuid

  callId String @unique @map("call_id") @db.Uuid
  call   Call   @relation(fields: [callId], references: [id])

  transcriptText String? @map("transcript_text")

  language String? @map("language") @db.VarChar(20)
  provider String? @map("provider") @db.VarChar(100)

  status String? @map("status") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("call_transcripts")
}
