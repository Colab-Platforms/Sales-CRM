model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  provider String @map("provider") @db.VarChar(100)

  eventType String @map("event_type") @db.VarChar(150)

  externalEventId String? @map("external_event_id") @db.VarChar(255)

  payload Json @map("payload")

  status WebhookStatus @default(RECEIVED) @map("status")

  errorMessage String? @map("error_message")

  attempts      Int       @default(0) @map("attempts")
  nextAttemptAt DateTime? @map("next_attempt_at")
  sourceId String? @map("source_id") @db.Uuid
  source   Source? @relation(fields: [sourceId], references: [id])

  receivedAt  DateTime  @map("received_at")
  processedAt DateTime? @map("processed_at")

  // OMS forwarding (independent of `status`/`attempts`/`errorMessage` above, which track this
  // backend's OWN processing of the event -- a forwarding failure must never touch those fields,
  // and vice versa). See whatsapp.oms-forward.worker.ts.
  omsForwardStatus      OmsForwardStatus @default(PENDING) @map("oms_forward_status")
  omsForwardAttempts    Int              @default(0) @map("oms_forward_attempts")
  omsForwardNextAttemptAt DateTime?      @map("oms_forward_next_attempt_at")
  omsForwardErrorMessage  String?        @map("oms_forward_error_message")
  omsForwardedAt          DateTime?      @map("oms_forwarded_at")

  @@unique([provider, externalEventId])
  @@index([provider])
  @@index([eventType])
  @@index([externalEventId])
  @@index([status, nextAttemptAt])
  @@index([status])
  @@index([receivedAt])
  @@index([sourceId])
  @@index([omsForwardStatus, omsForwardNextAttemptAt])
  @@map("webhook_events")
}
