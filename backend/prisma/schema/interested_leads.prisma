model InterestedLeadPeriod {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  qualifiedById String @map("qualified_by_id") @db.Uuid
  qualifiedBy   User   @relation("InterestedLeadPeriodQualifiedBy", fields: [qualifiedById], references: [id])

  startedAt DateTime  @map("started_at")
  expiresAt DateTime  @map("expires_at")
  endedAt   DateTime? @map("ended_at")

  status InterestedPeriodStatus @default(ACTIVE) @map("status")

  reason String? @map("reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([status])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@map("interested_lead_periods")
}
