model Lead {
  id String @id @default(uuid()) @db.Uuid

  leadNumber String @unique @map("lead_number") @db.VarChar(50)

  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)

  mobile           String? @map("mobile") @db.VarChar(20)
  normalizedMobile String? @map("normalized_mobile") @db.VarChar(20)

  email           String? @map("email") @db.VarChar(255)
  normalizedEmail String? @map("normalized_email") @db.VarChar(255)

  requirement String? @map("requirement")
  location    String? @map("location") @db.VarChar(255)

  sourceId String? @map("source_id") @db.Uuid
  source   Source? @relation(fields: [sourceId], references: [id])

  interestedProductId String?  @map("interested_product_id") @db.Uuid
  interestedProduct   Product? @relation(fields: [interestedProductId], references: [id])

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  assignedManagerId String? @map("assigned_manager_id") @db.Uuid
  assignedManager   User?   @relation("LeadAssignedManager", fields: [assignedManagerId], references: [id])

  importBatchId String?          @map("import_batch_id") @db.Uuid
  importBatch   LeadImportBatch? @relation(fields: [importBatchId], references: [id])

  workingStatus LeadWorkingStatus @default(NEW) @map("working_status")
  priority      LeadPriority      @default(MEDIUM) @map("priority")

  lifecycleStage LifecycleStage @default(LEAD) @map("lifecycle_stage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lastContactedAt DateTime? @map("last_contacted_at")
  lastActivityAt  DateTime? @map("last_activity_at")

  // Daily work bucket: the day (IST calendar date) the lead was put in its owner's bucket, and when it was worked.
  bucketDate   DateTime? @map("bucket_date") @db.Date
  bucketDoneAt DateTime? @map("bucket_done_at")

  // Identity in an external system (Shopify). Null for records created inside the CRM.
  externalSource    ExternalSource? @map("external_source")
  externalId        String?         @map("external_id") @db.VarChar(100)
  externalUpdatedAt DateTime?       @map("external_updated_at")

  assignments              LeadAssignment[]
  communicationPreferences CommunicationPreference[]
  calls                    Call[]
  tasks                    Task[]
  interestedPeriods        InterestedLeadPeriod[]
  orders                   Order[]
  abandonments             Abandonment[]
  recoveryActions          RecoveryAction[]
  activities               Activity[]
  whatsAppMessages         WhatsAppMessage[]
  whatsAppConversation     WhatsAppConversation?
  whatsAppAutomationRuns   WhatsAppAutomationRun[]
  whatsAppCampaignRecipients WhatsAppCampaignRecipient[]

  @@unique([externalSource, externalId])
  @@index([normalizedMobile])
  @@index([normalizedEmail])
  @@index([sourceId])
  @@index([ownerId])
  @@index([ownerId, bucketDate])
  @@index([groupId])
  @@index([assignedManagerId])
  @@index([importBatchId])
  @@index([workingStatus])
  @@index([lifecycleStage, createdAt])
  @@index([priority])
  @@index([createdAt])
  @@map("leads")
}

model LeadAssignment {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation("LeadAssignmentUser", fields: [userId], references: [id])

  groupId String? @map("group_id") @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  assignmentType AssignmentType @map("assignment_type")

  assignedById String? @map("assigned_by_id") @db.Uuid
  assignedBy   User?   @relation("LeadAssignmentAssignedBy", fields: [assignedById], references: [id])

  assignedAt   DateTime  @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  isCurrent Boolean @default(true) @map("is_current")

  @@index([leadId])
  @@index([userId])
  @@index([groupId])
  @@index([assignedAt])
  @@index([isCurrent])
  @@map("lead_assignments")
}

model GroupAssignmentConfig {
  id String @id @default(uuid()) @db.Uuid

  groupId String @unique @map("group_id") @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  strategy String @default("ROUND_ROBIN") @map("strategy") @db.VarChar(50)

  lastAssignedUserId String? @map("last_assigned_user_id") @db.Uuid
  lastAssignedUser   User?   @relation("GroupAssignmentConfigLastAssignedUser", fields: [lastAssignedUserId], references: [id])

  isActive Boolean @default(true) @map("is_active")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("group_assignment_configs")
}

model LeadImportBatch {
  id String @id @default(uuid()) @db.Uuid

  fileName String @map("file_name") @db.VarChar(255)

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation("LeadImportBatchUploadedBy", fields: [uploadedById], references: [id])

  status ImportBatchStatus @default(DRAFT) @map("status")

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  invalidRows   Int @default(0) @map("invalid_rows")

  columnMapping Json  @map("column_mapping")
  parsedRows    Json? @map("parsed_rows")
  errorRows     Json? @map("error_rows")

  createdAt   DateTime  @default(now()) @map("created_at")
  committedAt DateTime? @map("committed_at")

  leads Lead[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("lead_import_batches")
}

model ManagerAssignmentRoundRobin {
  id String @id @default(uuid()) @db.Uuid

  lastAssignedManagerId String? @map("last_assigned_manager_id") @db.Uuid
  lastAssignedManager   User?   @relation("ManagerAssignmentRoundRobinLastAssignedManager", fields: [lastAssignedManagerId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("manager_assignment_round_robin")
}

model SalespersonAssignmentRoundRobin {
  id String @id @default(uuid()) @db.Uuid

  managerId String @unique @map("manager_id") @db.Uuid
  manager   User   @relation("SalespersonAssignmentRoundRobinManager", fields: [managerId], references: [id])

  lastAssignedSalespersonId String? @map("last_assigned_salesperson_id") @db.Uuid
  lastAssignedSalesperson   User?   @relation("SalespersonAssignmentRoundRobinLastAssigned", fields: [lastAssignedSalespersonId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salesperson_assignment_round_robin")
}

// Admin's single on/off switch for auto-assigning newly-arrived abandoned leads to a manager via
// round robin, alongside the existing manual bulk-assign flow. Missing row = disabled (same "at
// most one row, missing = default" convention as WhatsAppConfig/WhatsAppAutomationConfig) - auto-
// assignment must be explicitly turned on, never silently active.
model ManagerAutoAssignConfig {
  id String @id @default(uuid()) @db.Uuid

  enabled Boolean @default(false) @map("enabled")

  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("ManagerAutoAssignConfigUpdatedBy", fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("manager_auto_assign_config")
}

// Which managers participate in ManagerAutoAssignConfig's round robin - admin picks a subset of
// managers rather than every active manager getting leads. One row per selected manager; a manager
// with no row here is skipped by autoAssignManagerForLead even while the master toggle is enabled.
model ManagerAutoAssignTarget {
  id String @id @default(uuid()) @db.Uuid

  managerId String @unique @map("manager_id") @db.Uuid
  manager   User   @relation("ManagerAutoAssignTargetManager", fields: [managerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("manager_auto_assign_targets")
}

// Each manager's own on/off switch for auto-assigning abandoned leads under them to their
// salespeople via round robin. One row per manager, created lazily on first toggle - a manager
// with no row here has auto-assignment disabled, same as a missing ManagerAutoAssignConfig row.
model SalespersonAutoAssignConfig {
  id String @id @default(uuid()) @db.Uuid

  managerId String @unique @map("manager_id") @db.Uuid
  manager   User   @relation("SalespersonAutoAssignConfigManager", fields: [managerId], references: [id])

  enabled Boolean @default(false) @map("enabled")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salesperson_auto_assign_config")
}

// Per-manager cap on how many of their salespeople may be on a tea/lunch/bio break at the same
// time. One row per manager, created on first save - a manager with no row has no cap.
model BreakLimitConfig {
  id String @id @default(uuid()) @db.Uuid

  managerId String @unique @map("manager_id") @db.Uuid
  manager   User   @relation("BreakLimitConfigManager", fields: [managerId], references: [id])

  maxConcurrentBreaks Int @map("max_concurrent_breaks")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("break_limit_config")
}

model CommunicationPreference {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  channel CommunicationChannel @map("channel")

  status CommunicationPreferenceStatus @default(UNKNOWN) @map("status")

  source String? @map("source") @db.VarChar(100)

  consentAt  DateTime? @map("consent_at")
  optedOutAt DateTime? @map("opted_out_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([leadId, channel])
  @@index([status])
  @@map("communication_preferences")
}

// 24/7 ABANDONED-LEAD POOL (migration 20261102000000). A fixed list of telecallers who each receive new abandoned leads in round-robin order, whether or not they are present, on shift or online.
// `AbandonedPoolState` is the single switch + persisted cursor (one row; missing or disabled = the pool does nothing and the existing manager / salesperson auto-assign stays as it was); the row is locked
// (SELECT ... FOR UPDATE) while a lead is assigned so concurrent assignments are serialised and the sequence survives restarts. User ids are plain ids (no relation), like ownerId elsewhere: the service re-reads each
// user at assignment time and skips one that is disabled or gone.
model AbandonedPoolMember {
  id String @id @default(uuid()) @db.Uuid

  userId   String @unique @map("user_id") @db.Uuid
  // Round-robin order (ascending).
  position Int    @map("position")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("abandoned_pool_member")
}

model AbandonedPoolState {
  id String @id @default(uuid()) @db.Uuid

  enabled Boolean @default(false) @map("enabled")
  // When the pool was switched on: only abandoned leads created at or after this are picked up by the automatic retry sweep. Older unassigned leads need the explicit, approved backfill.
  enabledAt DateTime? @map("enabled_at")
  lastAssignedUserId String? @map("last_assigned_user_id") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("abandoned_pool_state")
}
