enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  ASSIGNMENT
  REASSIGNMENT
  CALL
  NOTE
  STATUS_CHANGE
  INTERESTED
  INTERESTED_EXPIRED
  ORDER_CREATED
  ORDER_CONFIRMED
  PAYMENT
  ABANDONMENT
  RECOVERY
  TASK

  // E6.6 Audit Trail: more specific types recorded going forward for events that used to share a
  // generic type above (STATUS_CHANGE, PAYMENT) or were not recorded as Activity at all (shipments,
  // discount changes). The generic types above are kept so historical rows keep rendering correctly.
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  PAYMENT_CREATED
  PAYMENT_STATUS_CHANGED
  PAYMENT_REFUNDED
  PAYMENT_MISMATCH_DETECTED
  SHIPMENT_CREATED
  SHIPMENT_STATUS_CHANGED
  TRACKING_UPDATED
  DISCOUNT_CHANGED

  // E7.1 WhatsApp Provider Integration: recorded for real message sends/receipts/status
  // transitions only - never invented for a message that was not actually sent/received.
  WHATSAPP_MESSAGE_SENT
  WHATSAPP_MESSAGE_RECEIVED
  WHATSAPP_DELIVERED
  WHATSAPP_READ
  WHATSAPP_FAILED

  // E7.2 Template Management: not tied to any one customer, so these are the only ActivityType
  // values ever written with a null leadId.
  WHATSAPP_TEMPLATE_CREATED
  WHATSAPP_TEMPLATE_UPDATED
  WHATSAPP_TEMPLATE_STATUS_CHANGED
  WHATSAPP_TEMPLATE_SYNCED

  // E7.7 Campaign & Bulk Messaging: campaign-level lifecycle events, not tied to any one customer
  // (null leadId, same convention as the WHATSAPP_TEMPLATE_* rows above). A campaign's individual
  // per-recipient sends still use WHATSAPP_MESSAGE_SENT/WHATSAPP_FAILED above - never a second,
  // duplicate activity for the same logical message.
  WHATSAPP_CAMPAIGN_CREATED
  WHATSAPP_CAMPAIGN_LAUNCHED
  WHATSAPP_CAMPAIGN_CANCELLED
  WHATSAPP_CAMPAIGN_COMPLETED

  // Cashfree payment links and Shiprocket shipments created from the CRM. Status changes on the payment/shipment
  // themselves reuse PAYMENT_STATUS_CHANGED / SHIPMENT_STATUS_CHANGED / TRACKING_UPDATED above.
  PAYMENT_LINK_CREATED
  PAYMENT_LINK_CANCELLED
  SHIPMENT_AWB_ASSIGNED
  SHIPMENT_PICKUP_SCHEDULED
  SHIPMENT_LABEL_GENERATED

  // WhatsApp Cloud API (Meta, official) foundation - configuration lifecycle events for the new
  // WhatsAppConfig row. Distinct from the WHATSAPP_TEMPLATE_* events above (those are about a
  // message template, not the provider connection itself). Never written with credential values.
  WHATSAPP_CLOUD_CONFIG_CREATED
  WHATSAPP_CLOUD_CONFIG_UPDATED
  WHATSAPP_CLOUD_CONFIG_RESET
  WHATSAPP_CLOUD_CONFIG_TESTED
  WHATSAPP_CLOUD_CONFIG_WEBHOOK_VERIFIED

  // WhatsApp Inbox conversation-level events (assignment, AI/human handoff) - distinct from the
  // message-level WHATSAPP_* events above, which are about one message, not the conversation itself.
  CONVERSATION_ASSIGNED
  CONVERSATION_AI_HANDOFF
  CONVERSATION_HUMAN_HANDBACK

  @@map("activity_type")
}

// Who/what actually caused an audit event, so a system/integration action never looks like a human one.
enum ActivitySource {
  USER
  SHOPIFY_SYNC
  SHOPIFY_WEBHOOK
  SYSTEM
  // A WhatsApp BSP webhook delivery (inbound message, or an async status update for an outbound
  // one) - mirrors SHOPIFY_WEBHOOK. An actual outbound send triggered by a signed-in user is
  // recorded with source USER instead, same as any other user-initiated write.
  WHATSAPP_WEBHOOK
  // Provider webhook deliveries, mirroring SHOPIFY_WEBHOOK / WHATSAPP_WEBHOOK.
  CASHFREE_WEBHOOK
  SHIPROCKET_WEBHOOK
  // A real Meta WhatsApp Cloud API webhook delivery - kept distinct from WHATSAPP_WEBHOOK (which
  // covers AiSensy's Direct-API relay of the same envelope shape) so the two integrations are never
  // conflated in the audit trail while both exist side by side.
  WHATSAPP_CLOUD_WEBHOOK

  @@map("activity_source")
}

