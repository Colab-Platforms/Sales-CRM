DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"
PORT=5000
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# --- Telephony (CallerDesk primary / Exotel backup). Leave values empty in git; set real values only in your own .env or hosting dashboard.
# CallerDesk "authcode" (Dashboard -> Integration Settings -> API key). Required for POST /api/calls (click-to-call). Never commit a real value.
CALLERDESK_API_KEY=""
# Optional: if set, the CallerDesk webhook URL must be registered as /api/webhooks/callerdesk?token=<this value>.
CALLERDESK_WEBHOOK_TOKEN=""
# Optional: timezone of CallerDesk timestamps (default +05:30, unverified).
CALLERDESK_TIMESTAMP_UTC_OFFSET="+05:30"
# Optional: CALLERDESK | EXOTEL (defaults CALLERDESK / EXOTEL). Fallback may also be NONE.
TELEPHONY_PRIMARY_PROVIDER="CALLERDESK"
TELEPHONY_FALLBACK_PROVIDER="EXOTEL"
