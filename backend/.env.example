DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"
PORT=5000
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
# REQUIRED. 32-byte key, base64-encoded (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts every stored integration secret at rest: Source credentials AND the WhatsApp Config screen's Meta access token,
# app secret, webhook verify token and Gemini API key. KEEP IT STABLE after deployment - if it changes or is lost, saved secrets
# can no longer be decrypted ("Stored credentials cannot be decrypted") and must be re-entered via Settings -> WhatsApp Config -> Reset.
# Use the same value everywhere the same database is used (local, Render).
INTEGRATION_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN="" # fallback verify token for Meta's webhook GET handshake
CALLERDESK_BASE_URL="https://app.callerdesk.io" # CallerDesk API base URL
CALLERDESK_API_KEY="" # CallerDesk dashboard "API Key" — sent as the click_to_call_v2 `authcode`
CALLERDESK_API_SECRET="" # CallerDesk dashboard "Secret Key" (not used by click_to_call_v2, kept for future endpoints)
CALLERDESK_WEBHOOK_SECRET="" # shared secret CallerDesk sends back on call-report webhook calls

# Shopify <-> CRM. The bulk sync/webhooks only ever READ from Shopify; the one write is orders.service.ts's
# pushOrderToShopify (orderCreate, used by the WhatsApp Inbox "Create Order"/AI order flow). Real values go in backend/.env, never here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01
# First day of the orders the CRM keeps (YYYY-MM-DD, read in the store's time zone). Older orders are not imported by
# the sync command or by webhooks. `npm run shopify:sync -- --since DATE` overrides it for one run.
SHOPIFY_SYNC_START_DATE=2026-01-01
# Webhooks: the app's client secret ("API secret key"), used to verify X-Shopify-Hmac-SHA256. Without it, the
# webhook endpoint refuses every delivery.
SHOPIFY_WEBHOOK_SECRET=
# false: webhook deliveries are verified and recorded but not processed. true: they are processed in the background.
# The manual command (npm run shopify:sync) does not depend on this.
SHOPIFY_SYNC_ENABLED=false

# WhatsApp provider integration (E7.1). Leave WHATSAPP_PROVIDER unset to keep WhatsApp fully off: the
# CRM works normally, /api/whatsapp/status reports "Not Configured", and nothing is ever sent. Set it
# to exactly one of AISENSY or GUPSHUP, then fill in only that provider's section below.
WHATSAPP_PROVIDER=

# AiSensy (primary provider). Campaign API key from the AiSensy dashboard.
AISENSY_API_KEY=
# WhatsApp Business number messages are sent from, e.g. 919876500000 (informational only).
AISENSY_SOURCE_NUMBER=
# Shared secret configured alongside the webhook URL in the AiSensy dashboard; verifies X-AiSensy-Signature.
AISENSY_WEBHOOK_SECRET=
# Webhook URL to register with AiSensy: <FRONTEND-facing backend URL>/api/webhooks/whatsapp/aisensy

# AiSensy Project Webhook (contact.created, message.created, message.status.updated, chat/campaign/
# payment/order/lead-form topics) - a SEPARATE AiSensy feature from the Direct/Campaign webhook
# above; see whatsapp.aisensy.webhook.config.ts. AiSensy documents no delivery-signing mechanism for
# it, so this is the CRM's own optional safeguard, not an AiSensy-verified signature: set it, then
# append `?token=<same value>` to the Endpoint URL you register in the AiSensy dashboard. Leave blank
# to accept every delivery unauthenticated (still safe: no CRM record is created from it - see the handler).
AISENSY_PROJECT_WEBHOOK_TOKEN=
# Webhook URL to register with AiSensy: <FRONTEND-facing backend URL>/api/webhooks/aisensy[?token=...]

# Gupshup (secondary/alternative provider).
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
# The Authorization token Gupshup is configured to send with every webhook callback.
GUPSHUP_WEBHOOK_TOKEN=
# Webhook URL to register with Gupshup: <FRONTEND-facing backend URL>/api/webhooks/whatsapp/gupshup

# Gupshup template sync (E7.2, optional). A separate Partner API credential - sending messages
# above does not need these. Leave any of the three unset to keep template sync reporting "not
# configured for template sync" while everything else keeps working.
GUPSHUP_APP_ID=
GUPSHUP_PARTNER_EMAIL=
GUPSHUP_PARTNER_PASSWORD=

# WhatsApp AI order-taking (Google Gemini, server-side only - never sent to the frontend).
# The normal way to configure it is Settings -> WhatsApp Config -> "AI Order Taking" (key/model saved encrypted with the
# Meta credentials). These variables are the FALLBACK used when nothing is saved on that screen (a screen setting wins;
# turning AI off there turns it off regardless of these). AI_PROVIDER: gemini (default) or none. With no key anywhere,
# every AI-mode conversation is simply handed to a human - nothing else breaks. Conversations default to HUMAN mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp Cloud API (Meta, official - foundation). Additive and separate from WHATSAPP_PROVIDER/
# AiSensy/Gupshup above: this integration's credentials (phone number ID, access token, app secret,
# webhook verify token) are entered by an ADMIN through Settings -> WhatsApp Config and stored
# encrypted in the database (WhatsAppConfig), not here - see whatsapp.cloud-config.service.ts. Only
# the Graph API version is env-configured, since it is not a credential.
META_GRAPH_API_VERSION=v21.0
# Webhook URL to register in the Meta App dashboard (shown, with a copy button, on Settings -> WhatsApp Config):
#   https://sales-crm-3pan.onrender.com/api/webhooks/whatsapp-cloud   (or <PUBLIC_BACKEND_URL>/api/webhooks/whatsapp-cloud)
# (GET for the one-time verification handshake, POST for message/status deliveries - both same URL).

# Cashfree payment links (CRM -> Cashfree). Leave CASHFREE_ENABLED unset/false to keep Cashfree fully off: no payment
# links can be created and the webhook endpoint refuses every delivery. The API host is chosen from CASHFREE_ENV, never
# from a URL variable (the older CASHFREE_API_URL / CASHFREE_BASE_URL are ignored).
CASHFREE_ENABLED=
# sandbox (default) or production.
CASHFREE_ENV=
# From the Cashfree dashboard (Developers > API Keys). The client secret also verifies webhook signatures.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional: Cashfree PG API version. Defaults to the version this integration was written against (2026-01-01).
CASHFREE_API_VERSION=
# Optional: how long a payment link stays payable, in hours (1-720, default 72).
CASHFREE_LINK_EXPIRY_HOURS=
# Optional: page the customer returns to after paying (https, max 250 characters).
CASHFREE_RETURN_URL=
# The public https address of THIS backend. Payment links tell Cashfree to post events to
# <PUBLIC_BACKEND_URL>/api/webhooks/cashfree. Without a public https URL links still work, but their status only
# updates through the "refresh" action.
PUBLIC_BACKEND_URL=

# Shiprocket shipments (CRM -> Shiprocket). Leave SHIPROCKET_ENABLED unset/false to keep Shiprocket fully off.
SHIPROCKET_ENABLED=
# An API user created in the Shiprocket panel (API > Configure > Create API user) - NOT the main account login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional: defaults to https://apiv2.shiprocket.in/v1/external. Must be an https URL on shiprocket.in.
SHIPROCKET_API_URL=
# The saved pickup location's name exactly as it appears in the Shiprocket panel.
SHIPROCKET_PICKUP_LOCATION=
# Shared token for the tracking webhook. Configure Shiprocket (Settings > API > Webhooks) to POST to
# <PUBLIC_BACKEND_URL>/api/webhooks/shiprocket with this value as the x-api-key header. Without it the webhook
# endpoint refuses every delivery.
SHIPROCKET_WEBHOOK_SECRET=
