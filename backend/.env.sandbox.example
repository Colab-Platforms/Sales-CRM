# TEMPLATE for the Cashfree SANDBOX test process. Copy to `.env.sandbox.local` (git-ignored), fill in the values, and start with sandbox/start-sandbox.ps1.
# NEVER copy values from the production `.env`, and never put sandbox values in `.env`. This file holds NO secrets.
#
# The launcher loads ONLY `.env.sandbox.local`, sets CRM_SANDBOX_MODE=true in the process environment, and the app then refuses to start
# (see src/modules/cashfree/cashfree.sandbox-guard.ts) if anything here could reach production.

# --- a THROW-AWAY database (never the production Neon database) -----------------------------------------------------------------------
# A separate Neon project/branch/database whose name contains "sandbox" or "test", or a local database. You migrate it yourself (npx prisma migrate deploy).
DATABASE_URL="postgresql://<user>:<password>@<non-production-host>/<db-name-containing-sandbox>?sslmode=require"

# --- Cashfree SANDBOX (Cashfree dashboard > Test environment > Developers > API Keys) -------------------------------------------------
CASHFREE_ENABLED=true
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Type this only after checking the two values above are the SANDBOX keys (they cannot be told apart offline).
CASHFREE_SANDBOX_CREDENTIALS_CONFIRMED=true
CASHFREE_UPI_QR_ENABLED=true
# Cashfree posts webhooks here: the public https address of THIS sandbox backend (e.g. a tunnel). Register <PUBLIC_BACKEND_URL>/api/webhooks/cashfree in the sandbox dashboard.
PUBLIC_BACKEND_URL=https://<your-sandbox-tunnel>
# Optional extra guards: hosts that must never be used (comma separated).
# CRM_PRODUCTION_DB_HOSTS=
# CRM_PRODUCTION_BACKEND_HOSTS=

# --- must stay OFF in a sandbox run (the guard refuses otherwise) --------------------------------------------------------------------
WHATSAPP_PROVIDER=
SHOPIFY_SYNC_ENABLED=false

# --- app basics (any throw-away values) --------------------------------------------------------------------------------------------
JWT_SECRET=
PORT=5100
# Webhook worker stays on (it processes Cashfree events); nothing else here talks to customers.
